#!/usr/bin/env python3
"""
codex-worker: Lightweight, safe wrapper around Codex CLI for Antigravity.

Uses `codex app-server --stdio` by default so dispatched sessions are created
with `vscode` source and appear directly in the Codex Desktop App sidebar under
the project directory. Falls back to `codex exec` when `--worktree` is requested.

Defaults:
- Sandbox: workspace-write (use --read-only for analysis-only tasks)
- Reasoning effort: medium (capped at high; use --hard or --effort high for hard tasks)
- Model: inherits from ~/.codex/config.toml unless overridden with -m/--model
- Session tracking: prints session_id so follow-ups can use --resume <id>
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile
import time
import uuid
from pathlib import Path
from typing import Any, NamedTuple, Optional

from codex_runtime import (
    RECEIPT_LOG_ENV,
    StderrTail,
    append_task_receipt,
    receipt_log_requested,
    report_config_error,
    report_launch_error,
    report_writer_lock_error,
    resolve_codex,
    resolve_receipt_log,
    resolve_reveal_mode,
    resolve_target_dir,
    resolve_task_id,
    reveal_in_desktop_app,
)

ALLOWED_EFFORTS = ("low", "medium", "high")

WRITE_MODE_INSTRUCTIONS = (
    "你是主控在用户已明确授权后派发的执行者：在给定任务范围内请直接落地修改并完成自测，"
    "不要因改动规模或常规重构停下来二次请示；仅在遇到超出任务范围的高风险操作或明确阻塞时才暂停询问。"
    "所有需要主控查看或验收的临时产物（预览图、截图、日志、临时脚本等）统一放在当前工作区内"
    "（例如 `.tmp/`，且不要提交进 git），不要放到 `/tmp`。"
)

READ_ONLY_INSTRUCTIONS = (
    "所有需要主控查看或验收的临时产物（日志、分析文件等）请优先放在当前工作区内"
    "（例如 `.tmp/`，且不要提交进 git），不要放到 `/tmp`。"
)


class TaskResult(NamedTuple):
    exit_code: int
    status: str
    session_id: Optional[str]
    summary: str


def is_git_repo(directory: Path) -> bool:
    result = subprocess.run(
        ["git", "-C", str(directory), "rev-parse", "--is-inside-work-tree"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="codex-worker",
        description="Delegate a coding task to local Codex CLI with safe defaults and session tracking.",
    )
    parser.add_argument(
        "-C",
        "--cd",
        default=None,
        help="Target working directory (defaults to CODEX_WORKER_DEFAULT_DIR if set, otherwise '.').",
    )
    parser.add_argument(
        "-e",
        "--effort",
        choices=ALLOWED_EFFORTS,
        default="medium",
        help="Reasoning effort: low, medium (default), or high.",
    )
    parser.add_argument(
        "--hard",
        action="store_true",
        help="Shorthand for --effort high (for complex logic, refactors, or tricky bugs).",
    )
    parser.add_argument(
        "-m",
        "--model",
        default=None,
        help="Optional model override (defaults to ~/.codex/config.toml).",
    )
    sandbox_group = parser.add_mutually_exclusive_group()
    sandbox_group.add_argument(
        "--read-only",
        action="store_true",
        help="Run Codex in read-only sandbox mode (no file edits).",
    )
    sandbox_group.add_argument(
        "--allow-full",
        action="store_true",
        help="Run Codex in danger-full-access sandbox (only when explicitly authorized, e.g. for local Chromium or SSH).",
    )
    parser.add_argument(
        "--worktree",
        action="store_true",
        help="Run Codex in a new managed Git worktree for isolated changes.",
    )
    parser.add_argument(
        "--resume",
        metavar="SESSION_ID",
        default=None,
        help="Resume an existing Codex session by ID (or pass 'last' for the most recent).",
    )
    parser.add_argument(
        "--raw",
        action="store_true",
        help="Print raw JSON/JSON-RPC event stream from Codex.",
    )
    parser.add_argument("--task-id", metavar="ID", help="Task ID shared across runs (default: generated).")
    parser.add_argument("--receipt-log", metavar="PATH", help=f"Append JSONL receipts (overrides {RECEIPT_LOG_ENV}).")
    reveal_group = parser.add_mutually_exclusive_group()
    reveal_group.add_argument(
        "--reveal",
        dest="reveal",
        action="store_const",
        const=True,
        default=None,
        help="Hand off and reveal the completed session in an already-running macOS Codex Desktop app (locks the thread in Desktop).",
    )
    reveal_group.add_argument(
        "--no-reveal",
        dest="reveal",
        action="store_const",
        const=False,
        help="Do not reveal the session in Codex Desktop (default; keeps --resume unlocked).",
    )
    reveal_group.add_argument(
        "--reveal-only",
        metavar="SESSION_ID",
        default=None,
        help="Reveal an existing session in a background macOS Codex Desktop app without running a new turn.",
    )
    parser.add_argument(
        "prompt",
        nargs="*",
        help="Task instruction for Codex (or '-' / stdin).",
    )
    return parser.parse_args()


def read_prompt(prompt_parts: list[str]) -> str:
    if prompt_parts == ["-"]:
        return sys.stdin.read().strip()
    if prompt_parts:
        text = " ".join(prompt_parts).strip()
        if not sys.stdin.isatty():
            piped = sys.stdin.read().strip()
            if piped:
                text = f"{text}\n\n{piped}"
        return text
    if not sys.stdin.isatty():
        return sys.stdin.read().strip()
    return ""


def print_footer(
    status: str,
    effort: str,
    sandbox: str,
    model: Optional[str],
    target_dir: Path,
    session_id: Optional[str],
    task_id: str,
) -> None:
    print("\n---")
    print(
        f"[codex-worker] status={status} effort={effort} sandbox={sandbox} "
        f"model={model or 'default'} cwd={target_dir} task_id={task_id}"
    )
    if session_id:
        print(f"[codex-worker] session_id={session_id}")


def run_via_app_server(
    codex_bin: str,
    target_dir: Path,
    effort: str,
    sandbox: str,
    model: Optional[str],
    resume_id: Optional[str],
    prompt: str,
    raw: bool,
    task_id: str,
    reveal_mode: str = "never",
) -> TaskResult:
    """Run via `codex app-server --stdio` so threads appear in Codex Desktop App."""
    try:
        proc = subprocess.Popen(
            [codex_bin, "app-server", "--stdio"],
            cwd=str(target_dir),
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
        )
    except OSError as exc:
        report_launch_error(codex_bin, exc)
        return TaskResult(2, "failed(2)", None, str(exc))

    assert proc.stdin is not None
    assert proc.stdout is not None
    assert proc.stderr is not None
    stderr_tail = StderrTail(proc.stderr)

    def send(payload: dict[str, Any]) -> None:
        proc.stdin.write(json.dumps(payload, ensure_ascii=False) + "\n")
        proc.stdin.flush()

    thread_id: Optional[str] = None
    agent_messages: list[str] = []
    errors: list[str] = []
    turn_status = "failed"
    exit_code = 1
    dev_instructions = READ_ONLY_INSTRUCTIONS if sandbox == "read-only" else WRITE_MODE_INSTRUCTIONS

    try:
        send({
            "id": 1,
            "method": "initialize",
            "params": {
                "clientInfo": {"name": "codex-worker", "version": "0.1.0"},
            },
        })

        for line in proc.stdout:
            stripped = line.strip()
            if not stripped:
                continue
            if raw:
                print(stripped, flush=True)
            try:
                msg = json.loads(stripped)
            except json.JSONDecodeError:
                continue

            if not isinstance(msg, dict):
                continue

            msg_id = msg.get("id")
            if "error" in msg and msg["error"]:
                err = msg["error"]
                err_text = err.get("message") if isinstance(err, dict) else str(err)
                errors.append(f"RPC error (id={msg_id}): {err_text}")
                break

            if msg_id == 1:
                send({"method": "initialized"})
                if resume_id and resume_id.lower() == "last":
                    send({
                        "id": 10,
                        "method": "thread/list",
                        "params": {"cwd": str(target_dir), "limit": 1},
                    })
                elif resume_id:
                    params: dict[str, Any] = {
                        "threadId": resume_id,
                        "cwd": str(target_dir),
                        "sandbox": sandbox,
                        "approvalPolicy": "never",
                        "developerInstructions": dev_instructions,
                    }
                    if model:
                        params["model"] = model
                    send({"id": 2, "method": "thread/resume", "params": params})
                else:
                    params = {
                        "cwd": str(target_dir),
                        "sandbox": sandbox,
                        "approvalPolicy": "never",
                        "developerInstructions": dev_instructions,
                    }
                    if model:
                        params["model"] = model
                    send({"id": 2, "method": "thread/start", "params": params})

            elif msg_id == 10:
                res = msg.get("result") or {}
                threads = res.get("data") or res.get("threads") or []
                if not threads:
                    errors.append(f"No previous session found for {target_dir} to resume with --resume last.")
                    break
                latest_id = threads[0].get("id") if isinstance(threads[0], dict) else None
                if not latest_id:
                    errors.append("Could not determine latest thread ID from thread/list.")
                    break
                params = {
                    "threadId": latest_id,
                    "cwd": str(target_dir),
                    "sandbox": sandbox,
                    "approvalPolicy": "never",
                    "developerInstructions": dev_instructions,
                }
                if model:
                    params["model"] = model
                send({"id": 2, "method": "thread/resume", "params": params})

            elif msg_id == 2:
                res = msg.get("result") or {}
                thread_obj = res.get("thread")
                if isinstance(thread_obj, dict):
                    thread_id = thread_obj.get("id")
                if not thread_id:
                    thread_id = res.get("threadId") or resume_id
                if not thread_id:
                    errors.append("Failed to obtain threadId from app-server.")
                    break

                turn_params: dict[str, Any] = {
                    "threadId": thread_id,
                    "cwd": str(target_dir),
                    "effort": effort,
                    "approvalPolicy": "never",
                    "input": [{"type": "text", "text": prompt}],
                }
                if model:
                    turn_params["model"] = model
                send({"id": 3, "method": "turn/start", "params": turn_params})

            elif msg.get("method") == "item/completed":
                item = (msg.get("params") or {}).get("item")
                if isinstance(item, dict) and item.get("type") in ("agentMessage", "agent_message"):
                    text = item.get("text")
                    if isinstance(text, str) and text.strip():
                        agent_messages.append(text.strip())

            elif msg.get("method") == "turn/completed":
                turn = (msg.get("params") or {}).get("turn") or {}
                turn_status = turn.get("status") or "completed"
                turn_error = turn.get("error")
                if turn_error:
                    errors.append(str(turn_error))
                exit_code = 0 if turn_status == "completed" and not errors else 1
                break

            elif msg.get("method") == "error":
                err = (msg.get("params") or {}).get("message") or stripped
                errors.append(str(err))

    except BrokenPipeError as exc:
        errors.append(f"Codex app-server closed its input: {exc}")
    finally:
        if thread_id:
            try:
                send({"id": 4, "method": "thread/unsubscribe", "params": {"threadId": thread_id}})
            except OSError:
                pass
        try:
            proc.stdin.close()
        except OSError:
            pass
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()

    stderr_output = stderr_tail.finish()

    if exit_code == 0:
        reveal_in_desktop_app(thread_id, reveal_mode)

    status = "ok" if exit_code == 0 else f"failed({turn_status})"
    if not raw:
        if agent_messages:
            print(agent_messages[-1])
        if errors:
            print("Codex reported error(s):", file=sys.stderr)
            for err in errors:
                print(f"  - {err}", file=sys.stderr)
        if exit_code != 0 and stderr_output.strip():
            filtered = [
                l for l in stderr_output.splitlines()
                if "could not create PATH aliases" not in l
            ]
            if filtered:
                print("\n".join(filtered), file=sys.stderr)

        print_footer(status, effort, sandbox, model, target_dir, thread_id, task_id)

    if exit_code != 0:
        report_config_error(codex_bin, stderr_output, *errors)
        report_writer_lock_error(stderr_output, *errors)
    summary = (errors[0] if errors else "") or (agent_messages[-1] if agent_messages else "")
    return TaskResult(exit_code, status, thread_id, summary or stderr_output.strip())


def run_via_exec(
    codex_bin: str,
    target_dir: Path,
    effort: str,
    sandbox: str,
    model: Optional[str],
    resume_id: Optional[str],
    prompt: str,
    raw: bool,
    task_id: str,
    capture_summary: bool,
) -> TaskResult:
    """Fallback to `codex exec` (used for --worktree)."""
    try:
        with tempfile.NamedTemporaryFile(prefix="codex-worker-", suffix=".md", delete=False) as tmp:
            last_msg_path = Path(tmp.name)
    except OSError as exc:
        print(f"Error: could not create Codex output file: {exc}", file=sys.stderr)
        return TaskResult(1, "failed(1)", None, str(exc))

    try:
        cmd: list[str] = [codex_bin, "exec"]

        if resume_id:
            cmd.append("resume")
            cmd.extend(["-c", f'model_reasoning_effort="{effort}"'])
            cmd.extend(["-c", f'sandbox_mode="{sandbox}"'])
            if model:
                cmd.extend(["-m", model])
            cmd.append("--worktree")
            cmd.extend(["--json", "-o", str(last_msg_path)])
            if resume_id.lower() == "last":
                cmd.append("--last")
            else:
                cmd.append(resume_id)
            cmd.append(prompt)
        else:
            cmd.extend(["-C", str(target_dir)])
            cmd.extend(["-s", sandbox])
            cmd.extend(["-c", f'model_reasoning_effort="{effort}"'])
            if model:
                cmd.extend(["-m", model])
            cmd.append("--worktree")
            cmd.extend(["--json", "-o", str(last_msg_path)])
            cmd.append(prompt)

        try:
            proc = subprocess.Popen(
                cmd,
                cwd=str(target_dir),
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1,
            )
        except OSError as exc:
            report_launch_error(codex_bin, exc)
            return TaskResult(2, "failed(2)", None, str(exc))

        session_id = resume_id if (resume_id and resume_id.lower() != "last") else None
        agent_messages: list[str] = []
        errors: list[str] = []

        assert proc.stdout is not None
        for line in proc.stdout:
            stripped = line.strip()
            if not stripped:
                continue
            if raw:
                print(stripped, flush=True)
            try:
                event = json.loads(stripped)
            except json.JSONDecodeError:
                continue

            if not isinstance(event, dict):
                continue

            for key in ("thread_id", "session_id"):
                val = event.get(key)
                if isinstance(val, str) and val:
                    session_id = val

            event_type = event.get("type", "")
            if event_type in ("error", "turn.failed"):
                msg = event.get("message") or event.get("error") or stripped
                errors.append(str(msg))
            elif event_type == "item.completed":
                item = event.get("item")
                if isinstance(item, dict) and item.get("type") == "agent_message":
                    text = item.get("text")
                    if isinstance(text, str) and text.strip():
                        agent_messages.append(text.strip())

        stderr_output = proc.stderr.read() if proc.stderr else ""
        exit_code = proc.wait()

        final_message = ""
        if not raw or capture_summary:
            if last_msg_path.exists():
                try:
                    final_message = last_msg_path.read_text(encoding="utf-8", errors="replace").strip()
                except OSError:
                    pass
            if not final_message and agent_messages:
                final_message = agent_messages[-1]

        status = "ok" if exit_code == 0 else f"failed({exit_code})"
        if not raw:
            if final_message:
                print(final_message)
            elif errors:
                print("Codex reported error(s):", file=sys.stderr)
                for err in errors:
                    print(f"  - {err}", file=sys.stderr)

            if exit_code != 0 and stderr_output.strip():
                filtered = [
                    l for l in stderr_output.splitlines()
                    if "could not create PATH aliases" not in l
                ]
                if filtered:
                    print("\n".join(filtered), file=sys.stderr)

            print_footer(status, effort, sandbox, model, target_dir, session_id, task_id)

        if exit_code != 0:
            report_config_error(codex_bin, stderr_output, *errors)
        summary = (errors[0] if errors else "") or final_message or stderr_output.strip()
        return TaskResult(exit_code, status, session_id, summary)
    finally:
        try:
            last_msg_path.unlink(missing_ok=True)
        except OSError:
            pass


def main() -> int:
    args = parse_args()
    receipt_log = resolve_receipt_log(args.receipt_log)
    if receipt_log is None and receipt_log_requested(args.receipt_log):
        return 2
    if args.reveal_only:
        try:
            canonical_id = str(uuid.UUID(args.reveal_only))
        except ValueError:
            print(f"Error: --reveal-only requires a valid session UUID, got: {args.reveal_only}", file=sys.stderr)
            return 2
        revealed = reveal_in_desktop_app(canonical_id, "auto")
        state = "ok" if revealed else "skipped"
        print(f"[codex-worker] reveal={state} session_id={canonical_id}")
        return 0

    task_id = resolve_task_id(args.task_id)
    if task_id is None:
        return 2

    started = time.monotonic()
    effort = "high" if args.hard else args.effort
    if args.read_only:
        sandbox = "read-only"
    elif args.allow_full:
        sandbox = "danger-full-access"
    else:
        sandbox = "workspace-write"

    def record_prelaunch_failure(reason: str, cwd: Optional[Path] = None) -> int:
        append_task_receipt(receipt_log, {
            "tool": "codex-worker",
            "task_id": task_id,
            "session_id": None,
            "resume_from": args.resume,
            "cwd": str(cwd) if cwd is not None else (args.cd or os.environ.get("CODEX_WORKER_DEFAULT_DIR") or str(Path.cwd())),
            "effort": effort,
            "sandbox": sandbox,
            "model": args.model,
            "worktree": args.worktree,
            "scope": None,
            "status": "failed(2)",
            "exit_code": 2,
            "duration_ms": int((time.monotonic() - started) * 1000),
            "summary": reason,
        })
        return 2

    prompt = read_prompt(args.prompt)
    if not prompt:
        msg = "Error: task prompt is required (pass as argument or via stdin)."
        print(msg, file=sys.stderr)
        return record_prelaunch_failure(msg)

    target_dir = resolve_target_dir(args.cd, default_env_var="CODEX_WORKER_DEFAULT_DIR")
    if target_dir is None:
        return record_prelaunch_failure("target working directory validation failed")

    codex_bin = resolve_codex(target_dir)
    if codex_bin is None:
        return record_prelaunch_failure("codex executable resolution failed", cwd=target_dir)

    reveal_mode = resolve_reveal_mode(args.reveal)
    if reveal_mode is None:
        return record_prelaunch_failure("CODEX_WORKER_REVEAL validation failed", cwd=target_dir)

    if args.worktree and not is_git_repo(target_dir):
        msg = f"Error: --worktree requires a Git repository, but {target_dir} is not one."
        print(msg, file=sys.stderr)
        return record_prelaunch_failure(msg, cwd=target_dir)

    if args.worktree:
        result = run_via_exec(
            codex_bin=codex_bin,
            target_dir=target_dir,
            effort=effort,
            sandbox=sandbox,
            model=args.model,
            resume_id=args.resume,
            prompt=prompt,
            raw=args.raw,
            task_id=task_id,
            capture_summary=receipt_log is not None,
        )
    else:
        result = run_via_app_server(
            codex_bin=codex_bin,
            target_dir=target_dir,
            effort=effort,
            sandbox=sandbox,
            model=args.model,
            resume_id=args.resume,
            prompt=prompt,
            raw=args.raw,
            task_id=task_id,
            reveal_mode=reveal_mode,
        )

    append_task_receipt(receipt_log, {
        "tool": "codex-worker",
        "task_id": task_id,
        "session_id": result.session_id,
        "resume_from": args.resume,
        "cwd": str(target_dir),
        "effort": effort,
        "sandbox": sandbox,
        "model": args.model,
        "worktree": args.worktree,
        "scope": None,
        "status": result.status,
        "exit_code": result.exit_code,
        "duration_ms": int((time.monotonic() - started) * 1000),
        "summary": result.summary,
    })
    return result.exit_code


if __name__ == "__main__":
    raise SystemExit(main())
