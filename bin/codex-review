#!/usr/bin/env python3
"""
codex-review: Lightweight, structured code review wrapper around `codex review`.

Defaults:
- Scope: --uncommitted (or pass --base <branch> / --commit <sha>)
- Reasoning effort: medium (capped at high; use --hard or --effort high for risky changes)
- Output: concise Chinese review split into Blocking vs Advisory items
"""

import argparse
import os
import subprocess
import sys
import time
import uuid
from typing import Optional

from codex_runtime import (
    RECEIPT_LOG_ENV,
    append_task_receipt,
    receipt_log_requested,
    report_config_error,
    report_launch_error,
    resolve_codex,
    resolve_receipt_log,
    resolve_target_dir,
    resolve_task_id,
)

ALLOWED_EFFORTS = ("low", "medium", "high")

DEFAULT_REVIEW_PROMPT = """请审查上述代码变更，用简洁中文输出，严格分为两部分：
1. **阻断项（必须修）**：明确会导致逻辑错误、数据损坏/丢失、安全或权限问题、崩溃、或接口破坏的缺陷；每条给出具体文件路径和触发原因。没有则写“无”。
2. **建议项（可选优化）**：可读性、边界情况或性能改进建议，最多列 3 条。没有则写“无”。

不要复述 diff，不要客套。"""


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="codex-review",
        description="Run a concise, structured Codex code review on local changes.",
    )
    parser.add_argument(
        "-C",
        "--cd",
        default=".",
        help="Target repository directory (default: current directory).",
    )
    scope = parser.add_mutually_exclusive_group()
    scope.add_argument(
        "--uncommitted",
        action="store_true",
        help="Review staged, unstaged, and untracked changes (default).",
    )
    scope.add_argument(
        "--base",
        metavar="BRANCH",
        help="Review changes against the given base branch (e.g. main).",
    )
    scope.add_argument(
        "--commit",
        metavar="SHA",
        help="Review changes introduced by a specific commit.",
    )
    parser.add_argument(
        "-e",
        "--effort",
        choices=ALLOWED_EFFORTS,
        default="medium",
        help="Reasoning effort: low, medium (default), or high.",
    )
    parser.add_argument(
        "--hard",
        action="store_true",
        help="Shorthand for --effort high (for security, billing, or core logic changes).",
    )
    parser.add_argument(
        "-m",
        "--model",
        default=None,
        help="Optional model override (defaults to ~/.codex/config.toml).",
    )
    parser.add_argument("--task-id", metavar="ID", help="Task ID shared across runs (default: generated).")
    parser.add_argument("--receipt-log", metavar="PATH", help=f"Append JSONL receipts (overrides {RECEIPT_LOG_ENV}).")
    parser.add_argument(
        "extra_prompt",
        nargs="*",
        help="Optional extra focus areas for the review.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    receipt_log = resolve_receipt_log(args.receipt_log)
    if receipt_log is None and receipt_log_requested(args.receipt_log):
        return 2

    task_id = resolve_task_id(args.task_id)
    if task_id is None:
        return 2

    started = time.monotonic()
    effort = "high" if args.hard else args.effort
    if args.base:
        scope = f"base:{args.base}"
    elif args.commit:
        scope = f"commit:{args.commit}"
    else:
        scope = "uncommitted"

    def record_prelaunch_failure(reason: str, cwd: Optional[str] = None) -> int:
        append_task_receipt(receipt_log, {
            "tool": "codex-review",
            "task_id": task_id,
            "session_id": None,
            "resume_from": None,
            "cwd": cwd if cwd is not None else (args.cd or "."),
            "effort": effort,
            "sandbox": None,
            "model": args.model,
            "worktree": False,
            "scope": scope,
            "status": "failed(2)",
            "exit_code": 2,
            "duration_ms": int((time.monotonic() - started) * 1000),
            "summary": reason,
        })
        return 2

    target_dir = resolve_target_dir(args.cd)
    if target_dir is None:
        return record_prelaunch_failure("target repository directory validation failed")

    codex_bin = resolve_codex(target_dir)
    if codex_bin is None:
        return record_prelaunch_failure("codex executable resolution failed", cwd=str(target_dir))

    cmd: list[str] = [codex_bin, "review", "-c", f'model_reasoning_effort="{effort}"']

    if args.model:
        cmd.extend(["-c", f'model="{args.model}"'])

    if args.base:
        cmd.extend(["--base", args.base])
    elif args.commit:
        cmd.extend(["--commit", args.commit])
    else:
        cmd.append("--uncommitted")

    extra = " ".join(args.extra_prompt).strip()
    if extra:
        # Note: if codex review rejects combining scope flags with a positional prompt,
        # we fall back to running `codex exec -s read-only` with git diff context.
        prompt = f"{DEFAULT_REVIEW_PROMPT}\n\n额外重点关注：{extra}"
    else:
        prompt = DEFAULT_REVIEW_PROMPT

    try:
        proc = subprocess.run(
            cmd + [prompt],
            cwd=str(target_dir),
            capture_output=True,
            text=True,
            check=False,
        )
        # Some Codex versions disallow combining scope flags with a prompt.
        if proc.returncode != 0 and "cannot be used with" in (proc.stderr or ""):
            proc = subprocess.run(
                cmd,
                cwd=str(target_dir),
                capture_output=True,
                text=True,
                check=False,
            )
    except OSError as exc:
        report_launch_error(codex_bin, exc)
        exit_code = 2
        status = "failed(2)"
        summary = str(exc)
    else:
        exit_code = proc.returncode
        if proc.stdout:
            print(proc.stdout.strip())
        if proc.stderr:
            filtered = [
                l for l in proc.stderr.splitlines()
                if "could not create PATH aliases" not in l
            ]
            if filtered and exit_code != 0:
                print("\n".join(filtered), file=sys.stderr)

        if exit_code != 0:
            report_config_error(codex_bin, proc.stderr or "")

        status = "ok" if exit_code == 0 else f"failed({exit_code})"
        summary = (proc.stderr.strip() if exit_code != 0 else "") or proc.stdout.strip()
        print("\n---")
        print(
            f"[codex-review] status={status} effort={effort} "
            f"model={args.model or 'default'} cwd={target_dir} task_id={task_id}"
        )

    append_task_receipt(receipt_log, {
        "tool": "codex-review",
        "task_id": task_id,
        "session_id": None,
        "resume_from": None,
        "cwd": str(target_dir),
        "effort": effort,
        "sandbox": None,
        "model": args.model,
        "worktree": False,
        "scope": scope,
        "status": status,
        "exit_code": exit_code,
        "duration_ms": int((time.monotonic() - started) * 1000),
        "summary": summary,
    })
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
